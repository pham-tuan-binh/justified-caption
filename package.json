{
  "name": "justified-caption",
  "version": "1.0.0",
  "description": "An Electron app to overlay videos with justified meme-style captions and export them.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "test:download": "electron tools/download-harness.js",
    "test:visual": "electron tools/visual-test.js"
  },
  "keywords": [
    "electron",
    "video",
    "captions",
    "subtitles",
    "overlay"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "ffmpeg-static"
    ]
  }
}
